<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ranvier.Wgpu for the browser: the scene API on WebGPU, and on WebGL2 where a browser has no WebGPU,
       compiled to JavaScript with Fickl. Types.fs, Primitives.fs, Shaders.fs and ScenePass.fs are the .NET
       package's own files, linked unchanged. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Ranvier.Wgpu</RootNamespace>
    <AssemblyName>Fable.Ranvier.Wgpu</AssemblyName>
    <PackageId>Fable.Ranvier.Wgpu</PackageId>
    <Version>0.2.1</Version>
    <Title>Fable.Ranvier.Wgpu</Title>
    <Description>The Ranvier.Wgpu 3D scene API for the browser, compiled to JavaScript with Fickl: instanced meshes, lines, discs, section clipping, shader hooks and GPU picking on WebGPU, with a WebGL2 fallback.</Description>
    <PackageTags>ranvier;fsharp;fable;fickl;fable-library;fable-javascript;webgpu;webgl2;3d;graphics;wgsl</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarnOn>$(WarnOn);3390</WarnOn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fable.Ranvier.Wgpu.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Ranvier.Wgpu/Types.fs">
      <Link>./Types.fs</Link>
    </Compile>
    <Compile Include="../Ranvier.Wgpu/Primitives.fs">
      <Link>./Primitives.fs</Link>
    </Compile>
    <Compile Include="../Ranvier.Wgpu/Shaders.fs">
      <Link>./Shaders.fs</Link>
    </Compile>
    <Compile Include="GlslShaders.fs" />
    <Compile Include="WebGpu.fs" />
    <Compile Include="WebGl2.fs" />
    <Compile Include="Packing.fs" />
    <Compile Include="Backend.fs" />
    <Compile Include="WebGpuBackend.fs" />
    <Compile Include="WebGl2Backend.fs" />
    <Compile Include="Batches.fs" />
    <Compile Include="../Ranvier.Wgpu/ScenePass.fs">
      <Link>./ScenePass.fs</Link>
    </Compile>
    <Compile Include="WgpuContext.fs" />
  </ItemGroup>

  <!-- Fickl compiles a library package from the sources in its fable/ folder, and reads the Compile items of
       the project file there without evaluating it. It takes a Compile item's Link element as the file's
       place in that folder, so the four shared files are packed beside the others and keep their Link. It
       needs Fickl 0.11.0 or later, the first release with System.Numerics vectors and spans. -->
  <ItemGroup>
    <Content Include="Fable.Ranvier.Wgpu.fsproj;*.fs" PackagePath="fable/" />
    <Content Include="../Ranvier.Wgpu/Types.fs;../Ranvier.Wgpu/Primitives.fs;../Ranvier.Wgpu/Shaders.fs;../Ranvier.Wgpu/ScenePass.fs" PackagePath="fable/" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\brand\icon\ranvier-icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fickl.Core" Version="0.11.0" />
    <!-- The package's minimum FSharp.Core: the version in the first .NET 10 SDK. -->
    <PackageReference Update="FSharp.Core" Version="10.0.100" />
  </ItemGroup>

</Project>
