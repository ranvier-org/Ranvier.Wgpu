<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Ranvier.Wgpu</RootNamespace>
    <AssemblyName>Ranvier.Wgpu</AssemblyName>
    <PackageId>Ranvier.Wgpu</PackageId>
    <Version>0.3.1</Version>
    <Title>Ranvier.Wgpu</Title>
    <Description>NativeAOT-compatible F# 3D and WebGPU (webgpu.h / wgpu-native) engine for Ranvier with runtime WGSL shaders, 4x MSAA, hardware instancing, BIM section clipping, SDF discs, and GPU pixel picking.</Description>
    <PackageTags>ranvier;fsharp;webgpu;wgpu;3d;graphics;wgsl;bim;native</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarnOn>$(WarnOn);3390</WarnOn>
    <NoWarn>$(NoWarn);FS0009;FS0051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ranvier.Wgpu.Sdl" />
    <InternalsVisibleTo Include="Ranvier.Wgpu.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Generated/WgpuBindings.fs" />
    <Compile Include="Native.fs" />
    <Compile Include="Types.fs" />
    <Compile Include="Primitives.fs" />
    <Compile Include="Shaders.fs" />
    <Compile Include="Batches.fs" />
    <Compile Include="ScenePass.fs" />
    <Compile Include="WgpuContext.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The FSharp.Core floor of Ranvier.View.WebCore 0.1.2: the version in the first .NET 10 SDK. -->
    <PackageReference Update="FSharp.Core" Version="10.0.100" />
  </ItemGroup>

  <!-- Cross-RID native packaging for NuGet consumers (win-x64, win-arm64, linux-x64, linux-arm64, osx-arm64, osx-x64) -->
  <ItemGroup>
    <None Include="runtimes\win-x64\native\wgpu_native.dll"
          Condition="Exists('runtimes\win-x64\native\wgpu_native.dll')"
          Pack="true"
          PackagePath="runtimes/win-x64/native"
          Link="runtimes\win-x64\native\wgpu_native.dll" />
    <None Include="runtimes\win-arm64\native\wgpu_native.dll"
          Condition="Exists('runtimes\win-arm64\native\wgpu_native.dll')"
          Pack="true"
          PackagePath="runtimes/win-arm64/native"
          Link="runtimes\win-arm64\native\wgpu_native.dll" />
    <None Include="runtimes\linux-x64\native\libwgpu_native.so"
          Condition="Exists('runtimes\linux-x64\native\libwgpu_native.so')"
          Pack="true"
          PackagePath="runtimes/linux-x64/native"
          Link="runtimes\linux-x64\native\libwgpu_native.so" />
    <None Include="runtimes\linux-arm64\native\libwgpu_native.so"
          Condition="Exists('runtimes\linux-arm64\native\libwgpu_native.so')"
          Pack="true"
          PackagePath="runtimes/linux-arm64/native"
          Link="runtimes\linux-arm64\native\libwgpu_native.so" />
    <None Include="runtimes\osx-arm64\native\libwgpu_native.dylib"
          Condition="Exists('runtimes\osx-arm64\native\libwgpu_native.dylib')"
          Pack="true"
          PackagePath="runtimes/osx-arm64/native"
          Link="runtimes\osx-arm64\native\libwgpu_native.dylib" />
    <None Include="runtimes\osx-x64\native\libwgpu_native.dylib"
          Condition="Exists('runtimes\osx-x64\native\libwgpu_native.dylib')"
          Pack="true"
          PackagePath="runtimes/osx-x64/native"
          Link="runtimes\osx-x64\native\libwgpu_native.dylib" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\brand\icon\ranvier-icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="buildTransitive\Ranvier.Wgpu.targets" Pack="true" PackagePath="buildTransitive" />
    <None Include="buildTransitive\Ranvier.Wgpu.targets" Pack="true" PackagePath="build" />
  </ItemGroup>

  <Import Project="buildTransitive\Ranvier.Wgpu.targets" />

</Project>
