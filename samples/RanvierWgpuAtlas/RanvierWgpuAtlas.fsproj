<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Ranvier.D5.View 0.1.0-alpha.10 pins Ranvier.View [0.1.49-rc.3]; rc.4 is ABI-identical. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ranvier.Wgpu.Sdl\Ranvier.Wgpu.Sdl.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ranvier.View" Version="0.1.49-rc.4" />
    <PackageReference Include="Ranvier.D5" Version="0.1.0-alpha.10" />
    <PackageReference Include="Ranvier.D5.Charts" Version="0.1.0-alpha.10" />
    <PackageReference Include="Ranvier.D5.View" Version="0.1.0-alpha.10" />
  </ItemGroup>

</Project>
