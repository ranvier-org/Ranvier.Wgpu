<Project Sdk="Microsoft.NET.Sdk">

  <!-- Writes the .NET package's results for the shared cases, for tests/Fable.Ranvier.Wgpu.Tests to compare with. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/PackingCases.fs" Link="Shared/PackingCases.fs" />
    <Compile Include="../Shared/SceneCase.fs" Link="Shared/SceneCase.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ranvier.Wgpu\Ranvier.Wgpu.fsproj" />
  </ItemGroup>

</Project>
